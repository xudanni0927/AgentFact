# Copy this file to .env and fill in your own keys. .env is gitignored.

# Required for the main fact-checking pipeline (configs.py, agent_utils.py)
OPENAI_API_KEY=

# Optional: only needed if you switch agent_utils.py's model_version to "deepseek"
DEEPSEEK_API_KEY=

# Optional: only needed if query_evidence.py's search_api is set to "GOOGLE_CUSTOM_API"
# instead of the default "serper" backend
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
